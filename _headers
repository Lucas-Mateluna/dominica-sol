# Photos never change in place — let browsers keep them.
/assets/web/*
  Cache-Control: public, max-age=31536000, immutable

# Pages, scripts and styles: always check for a new version.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
